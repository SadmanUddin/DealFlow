    "@tanstack/react-query": "5.108.2",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.2",
    "tailwind-merge": "3.7.1",
