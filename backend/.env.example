# server config
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Authentication and security
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ARCJET_KEY=replace-with-your-Arcjet-key
# Generate a 256-bit hex key in your secret manager before enrolling administrators.
# Leave ADMIN_MFA_ENCRYPTION_KEY unset until intentionally provisioning that key.
ADMIN_MFA_REQUIRED=false
# Comma-separated trusted proxy IPs/CIDRs; leave empty for direct connections.
ARCJET_TRUSTED_PROXIES=

#database config
DATABASE_URL=postgresql://user:password@localhost:5432/dealflow

# Private conversation document storage (use "mock" in automated tests)
DOCUMENT_STORAGE_DRIVER=mock
DOCUMENT_MAX_SIZE_BYTES=10485760
# When true, new documents stay private and unavailable until scanner release.
DOCUMENT_QUARANTINE_REQUIRED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=notifications@example.com
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto
