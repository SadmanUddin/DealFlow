{"error":"Failed query: \n    WITH deal_guard AS MATERIALIZED (\n      SELECT id, buyer_id, seller_id, status FROM deals\n      WHERE id = $1 AND status IN ('proposed','negotiating','due_diligence')\n        AND $2 IN (buyer_id, seller_id)\n      FOR UPDATE\n    ), countered AS (\n      UPDATE deal_offers AS parent SET status = 'superseded', responded_at = now()\n      FROM deal_guard\n      WHERE $3::integer IS NOT NULL AND parent.id = $4\n        AND parent.deal_id = deal_guard.id AND parent.status = 'pending' AND parent.created_by <> $5\n      RETURNING id\n    ), offer AS (\n      INSERT INTO deal_offers(deal_id, parent_offer_id, created_by, amount, currency, message)\n      SELECT deal_guard.id, $6, $7, $8, $9, $10\n      FROM deal_guard\n      WHERE $11::integer IS NULL OR EXISTS (SELECT 1 FROM countered)\n      RETURNING *\n    ), deal_progress AS (\n      UPDATE deals SET status = 'negotiating', updated_at = now()\n      WHERE id = $12 AND status = 'proposed' AND EXISTS (SELECT 1 FROM offer) RETURNING id,buyer_id,seller_id\n    ), activity AS (\n      INSERT INTO deal_activities(deal_id, actor_id, event_type, metadata)\n      SELECT deal_id, created_by, CASE WHEN parent_offer_id IS NULL THEN 'offer.submitted' ELSE 'offer.countered' END, jsonb_build_object('offerId', id, 'amount', amount, 'currency', currency, 'parentOfferId', parent_offer_id) FROM offer\n      UNION ALL SELECT id, $13, 'deal.status_changed', jsonb_build_object('from', 'proposed', 'to', 'negotiating') FROM deal_progress RETURNING id\n    ), notify AS (\n      INSERT INTO notifications(user_id, dedupe_key, type, payload)\n      SELECT CASE WHEN offer.created_by = $14 THEN $15 ELSE $16 END,\n        'deal:' || $17 || ':offer:' || offer.id, CASE WHEN offer.parent_offer_id IS NULL THEN 'deal.offer' ELSE 'deal.counteroffer' END,\n        jsonb_build_object('dealId', $18, 'offerId', offer.id)\n      FROM offer ON CONFLICT (dedupe_key) DO NOTHING RETURNING id\n    ), email_event AS (\n      INSERT I