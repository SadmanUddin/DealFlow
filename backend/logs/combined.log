{"database":{"code":"42702","message":"column reference \"id\" is ambiguous","routine":"colNameToVar","severity":"ERROR"},"error":"Failed query: \n    WITH deal_guard AS MATERIALIZED (\n      SELECT id, buyer_id, seller_id, status FROM deals\n      WHERE id = $1 AND status IN ('proposed','negotiating','due_diligence')\n        AND $2 IN (buyer_id, seller_id)\n      FOR UPDATE\n    ), countered AS (\n      UPDATE deal_offers AS parent SET status = 'superseded', responded_at = now()\n      FROM deal_guard\n      WHERE $3::integer IS NOT NULL AND parent.id = $4\n        AND parent.deal_id = deal_guard.id AND parent.status = 'pending' AND parent.created_by <> $5\n      RETURNING id\n    ), offer AS (\n      INSERT INTO deal_offers(deal_id, parent_offer_id, created_by, amount, currency, message)\n      SELECT deal_guard.id, $6, $7, $8, $9, $10\n      FROM deal_guard\n      WHERE ($11::integer IS NULL OR EXISTS (SELECT 1 FROM countered))\n        AND ($12::integer IS NOT NULL OR NOT EXISTS (\n          SELECT 1 FROM deal_offers AS pending_offer\n          WHERE pending_offer.deal_id = deal_guard.id AND pending_offer.created_by = $13\n            AND pending_offer.status = 'pending'\n        ))\n      RETURNING *\n    ), deal_progress AS (\n      UPDATE deals SET status = 'negotiating', updated_at = now()\n      WHERE id = $14 AND status = 'proposed' AND EXISTS (SELECT 1 FROM offer) RETURNING id,buyer_id,seller_id\n    ), activity AS (\n      INSERT INTO deal_activities(deal_id, actor_id, event_type, metadata)\n      SELECT deal_id, created_by, CASE WHEN parent_offer_id IS NULL THEN 'offer.submitted' ELSE 'offer.countered' END, jsonb_build_object('offerId', id, 'amount', amount, 'currency', currency, 'parentOfferId', parent_offer_id) FROM offer\n      UNION ALL SELECT id, $15, 'deal.status_changed', jsonb_build_object('from', 'proposed', 'to', 'negotiating') FROM deal_progress RETURNING id\n    ), notification_events AS (\n      SELECT\n        CASE WHEN offer.created_by = $16 THEN $17 ELSE $18 END AS user_id,\n        'deal:' || $19 || ':offer:' || offer.id AS dedupe_key,\n        CASE WHEN offer.parent_offer_id IS NULL THEN 'deal.offer' ELSE 'deal.counteroffer' END AS type,\n        jsonb_build_object('dealId', $20, 'offerId', offer.id) AS payload\n      FROM offer\n      UNION ALL\n      SELECT recipients.user_id,\n        'deal:' || deal_progress.id || ':negotiating:' || recipients.user_id,\n        'deal.status_changed',\n        jsonb_build_object('dealId', deal_progress.id, 'status', 'negotiating')\n      FROM deal_progress CROSS JOIN LATERAL unnest(ARRAY[deal_progress.buyer_id, deal_progress.seller_id]) AS recipients(user_id)\n      WHERE recipients.user_id <> $21\n    ), notify AS (\n      INSERT INTO notifications(user_id, dedupe_key, type, payload)\n      SELECT user_id, dedupe_key, type, payload FROM notification_events\n      ON CONFLICT (dedupe_key) DO NOTHING RETURNING id\n    ), email_events AS (\n      SELECT\n        'deal:' || $22 || ':offer:' || offer.id AS event_key,\n        CASE WHEN offer.parent_offer_id IS NULL THEN 'deal.offer' ELSE 'deal.counteroffer' END AS type,\n        jsonb_build_object('dealId', $23, 'offerId', offer.id, 'recipientIds', jsonb_build_array(CASE WHEN offer.created_by = $24 THEN $25 ELSE $26 END)) AS payload\n      FROM offer\n      UNION ALL\n      SELECT 'deal:' || id || ':negotiating',\n        'deal.status_changed',\n        jsonb_build_object('dealId', id, 'status', 'negotiating', 'recipientIds', jsonb_build_array(buyer_id,seller_id))\n      FROM deal_progress\n    ), email_event AS (\n      INSERT INTO outbox_events(event_key, type, payload)\n      SELECT event_key, type, payload FROM email_events\n      ON CONFLICT (event_key) DO NOTHING RETURNING id\n    ) SELECT offer.* FROM offer CROSS JOIN activity\nparams: 1,23,,,23,,23,17000,EUR,,,,23,1,23,23,14,23,1,1,23,1,1,23,14,23","level":"error","message":"Unhandled API error","method":"POST","path":"/api/deals/1/offers","requestId":"b7