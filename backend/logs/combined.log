{"error":"Failed query: \n    WITH deal_guard AS MATERIALIZED (\n      SELECT id, buyer_id, seller_id, status FROM deals\n      WHERE id = $1 AND status IN ('proposed','negotiating','due_diligence')\n        AND $2 IN (buyer_id, seller_id)\n      FOR UPDATE\n    ), countered AS (\n      UPDATE deal_offers AS parent SET status = 'superseded', responded_at = now()\n      FROM deal_guard\n      WHERE $3::integer IS NOT NULL AND parent.id = $4\n        AND parent.deal_id = deal_guard.id AND parent.status = 'pending' AND parent.created_by <> $5\n      RETURNING id\n    ), offer AS (\n      INSERT INTO deal_offers(deal_id, parent_offer_id, created_by, amount, currency, message)\n      SELECT deal_guard.id, $6, $7, $8, $9, $10\n      FROM deal_guard\n      WHERE $11::integer IS NULL OR EXISTS (SELECT 1 FROM countered)\n      RETURNING *\n    ), deal_progress AS (\n      UPDATE deals SET status = 'negotiating', updated_at = now()\n      WHERE id = $12 AND status = 'proposed' AND EXISTS (SELECT 1 FROM offer) RETURNING id,buyer_id,seller_id\n    ), activity AS (\n      INSERT INTO deal_activities(deal_id, actor_id, event_type, metadata)\n      SELECT deal_id, created_by, CASE WHEN parent_offer_id IS NULL THEN 'offer.submitted' ELSE 'offer.countered' END, jsonb_build_object('offerId', id, 'amount', amount, 'currency', currency, 'parentOfferId', parent_offer_id) FROM offer\n      UNION ALL SELECT id, $13, 'deal.status_changed', jsonb_build_object('from', 'proposed', 'to', 'negotiating') FROM deal_progress RETURNING id\n    ), notify AS (\n      INSERT INTO notifications(user_id, dedupe_key, type, payload)\n      SELECT CASE WHEN offer.created_by = $14 THEN $15 ELSE $16 END,\n        'deal:' || $17 || ':offer:' || offer.id, CASE WHEN offer.parent_offer_id IS NULL THEN 'deal.offer' ELSE 'deal.counteroffer' END,\n        jsonb_build_object('dealId', $18, 'offerId', offer.id)\n      FROM offer ON CONFLICT (dedupe_key) DO NOTHING RETURNING id\n    ), email_event AS (\n      INSERT INTO outbox_events(event_key, type, payload)\n      SELECT 'deal:' || $19 || ':offer:' || offer.id, CASE WHEN offer.parent_offer_id IS NULL THEN 'deal.offer' ELSE 'deal.counteroffer' END,\n        jsonb_build_object('dealId', $20, 'offerId', offer.id, 'recipientIds', jsonb_build_array(CASE WHEN offer.created_by = $21 THEN $22 ELSE $23 END))\n      FROM offer ON CONFLICT (event_key) DO NOTHING RETURNING id\n    ), status_notice AS (\n      INSERT INTO notifications(user_id, dedupe_key, type, payload)\n      SELECT recipient, 'deal:' || deal_progress.id || ':negotiating:' || recipient, 'deal.status_changed', jsonb_build_object('dealId', deal_progress.id, 'status', 'negotiating')\n      FROM deal_progress CROSS JOIN LATERAL unnest(ARRAY[deal_progress.buyer_id, deal_progress.seller_id]) AS recipient WHERE recipient <> $24\n      ON CONFLICT (dedupe_key) DO NOTHING RETURNING id\n    ), status_email AS (\n      INSERT INTO outbox_events(event_key, type, payload)\n      SELECT 'deal:' || id || ':negotiating', 'deal.status_changed', jsonb_build_object('dealId', id, 'status', 'negotiating', 'recipientIds', jsonb_build_array(buyer_id,seller_id)) FROM deal_progress\n      ON CONFLICT (event_key) DO NOTHING RETURNING id\n    ) SELECT offer.* FROM offer CROSS JOIN activity\nparams: 1,23,,,23,,23,160000,EUR,i submitted,,1,23,23,14,23,1,1,1,1,23,14,23,23","level":"error","message":"Unhandled API error","method":"POST","path":"/api/deals/1/offers","service":"DealFlow-api","stack":"Error: Failed query: \n    WITH deal_guard AS MATERIALIZED (\n      SELECT id, buyer_id, seller_id, status FROM deals\n      WHERE id = $1 AND status IN ('proposed','negotiating','due_diligence')\n        AND $2 IN (buyer_id, seller_id)\n      FOR UPDATE\n    ), countered AS (\n      UPDATE deal_offers AS parent SET status = 'superseded', responded_at = now()\n      FROM deal_guard\n      WHERE $3::integer IS NOT NULL AND parent.id = $4\n        AND parent.deal_id = deal_guard.id AND parent.status = 'pending' AND parent.created_by <> $5\n      RETURNING id\n    ), offer AS (\n      INSERT INTO deal_offers(deal_id, parent_offer_id, created_by, amount, currency, message)\n      SELECT deal_guard.id, $6, $7, $8, $9, $10\n      FROM deal_guard\n      WHERE $11::integer IS NULL OR EXISTS (SELECT 1 FROM countered)\n      RETURNING *\n    ), deal_progress AS (\n      UPDATE deals SET status = 'negotiating', updated_at = now()\n      WHERE id = $12 AND status = 'proposed' AND EXISTS (SELECT 1 FROM offer) RETURNING id,buyer_id,seller_id\n    ), activity AS (\n      INSERT INTO deal_activities(deal_id, actor_id, event_type, metadata)\n      SELECT deal_id, created_by, CASE WHEN parent_offer_id IS NULL THEN 'offer.submitted' ELSE 'offer.countered' END, jsonb_build_object('offerId', id, 'amount', amount, 'currency', currency, 'parentOfferId', parent_offer_id) FROM offer\n      UNION ALL SELECT id, $13, 'deal.status_changed', jsonb_build_object('from', 'proposed', 'to', 'negotiating') FROM deal_progress RETURNING id\n    ), notify AS (\n      INSERT INTO notifications(user_id, dedupe_key, type, payload)\n      SELECT CASE WHEN offer.created_by = $14 THEN $15 ELSE $16 END,\n        'deal:' || $17 || ':offer:' || offer.id, CASE WHEN offer.parent_offer_id IS NULL THEN 'deal.offer' ELSE 'deal.counteroffer' END,\n        jsonb_build_object('dealId', $18, 'offerId', offer.id)\n      FROM offer ON CONFLICT (dedupe_key) DO NOTHING RETURNING id\n    ), email_event AS (\n      INSERT INTO outbox_events(event_key, type, payload)\n      SELECT 'deal:' || $19 || ':offer:' || offer.id, CASE WHEN offer.parent_offer_id IS NULL THEN 'deal.offer' ELSE 'deal.counteroffer' END,\n        jsonb_build_object('dealId', $20, 'offerId', offer.id, 'recipientIds', jsonb_build_array(CASE WHEN offer.created_by = $21 THEN $22 ELSE $23 END))\n      FROM offer ON CONFLICT (event_key) DO NOTHING RETURNING id\n    ), status_notice AS (\n      INSERT INTO notifications(user_id, dedupe_key, type, payload)\n      SELECT recipient, 'deal:' || deal_progress.id || ':negotiating:' || recipient, 'deal.status_changed', jsonb_build_object('dealId', deal_progress.id, 'status', 'negotiating')\n      FROM deal_progress CROSS JOIN LATERAL unnest(ARRAY[deal_progress.buyer_id, deal_progress.seller_id]) AS recipient WHERE recipient <> $24\n      ON CONFLICT (dedupe_key) DO NOTHING RETURNING id\n    ), status_email AS (\n      INSERT INTO outbox_events(event_key, type, payload)\n      SELECT 'deal:' || id || ':negotiating', 'deal.status_changed', jsonb_build_object('dealId', id, 'status', 'negotiating', 'recipientIds', jsonb_build_array(buyer_id,seller_id)) FROM deal_progress\n      ON CONFLICT (event_key) DO NOTHING RETURNING id\n    ) SELECT offer.* FROM offer CROSS JOIN activity\nparams: 1,23,,,23,,23,160000,EUR,i submitted,,1,23,23,14,23,1,1,1,1,23,14,23,23\n    at NeonHttpPreparedQuery.queryWithCache (file:///Users/mohammedsadmanuddin/DealFlow/node_modules/drizzle-orm/pg-core/session.js:41:15)\n    at process.processTicksAndRejections (node:internal/process/task_queues:104:5)\n    at async executeDealWrite (file:///Users/mohammedsadmanuddin/DealFlow/backend/src/services/deal.service.js:27:12)\n    at async createOffer (file:///Users/mohammedsadmanuddin/DealFlow/backend/src/services/deal.service.js:188:18)\n    at async offer (file:///Users/mohammedsadmanuddin/DealFlow/backend/src/controllers/deal.controller.js:53:12)"}
